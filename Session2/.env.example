# Environment Variables Template
# Copy this file to .env and fill in your actual values


# API URLs
JSONPLACEHOLDER_API_URL=your_api_url_here
WEATHER_API_URL=your_weather_api_url_here

# Location Configuration
LATITUDE=your_latitude_here
LONGITUDE=your_longitude_here
LOCATION_NAME=your_location_name_here

# Output file configurations
OUTPUT_POSTS_CSV=your_output_file_name.csv
OUTPUT_WEATHER_CSV=your_output_file_name.csv
OUTPUT_WEATHER_TEXT=your_output_file_name.txt
OUTPUT_FILTERED_CSV=your_output_file_name.csv

